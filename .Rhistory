finalize_workflow_helper <- function(
best_params,
workflow,
train_df
) {
# vi skal have params her
xgb_wf_final <- workflow |>
tune::finalize_workflow(best_params)
res <- final_xgb_fit <- xgb_wf_final |>
parsnip::fit(data = train_df)
return(res)
}
